# Copy to .env (git-ignored). Python scripts read exported variables;
# Docker Compose reads .env automatically.

# Azure Storage (Bronze / Silver / Gold)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
BLOB_CONTAINER_NAME=tenderbronze

# Private source configuration (NDA) -- choose ONE:
#   a) a file path (default: config/sources.local.json)
TENDER_SOURCES_CONFIG=config/sources.local.json
#   b) the whole JSON as one string (CI / cloud secrets)
# TENDER_SOURCES_JSON={"sa_source_01": {"api_url": "..."}}
#   c) one variable per setting: <ALIAS>_<KEY>
# SA_SOURCE_01_API_URL=...

# Runtime
HEADLESS=1
RESTORE_RAW_FROM_BRONZE=auto
SILVER_MODE=rebuild
GOLD_TIMEZONE=Asia/Riyadh
